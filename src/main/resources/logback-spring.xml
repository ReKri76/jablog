<configuration>

    <appender name="INFO_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <level>INFO</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
        <file>logs/info.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/info-%d{yyyy-MM-dd HH:mm:ss.SSS}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>2GB</totalSizeCap>
            <maxFileSize>128MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-8level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="ASYNC_INFO_LOG" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="INFO_LOG"/>
        <neverBlock>true</neverBlock>
        <queueSize>128</queueSize>
    </appender>

    <appender name="ERROR_LOG" class="ch.qos.logback.core.FileAppender">
        <level>ERROR</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
        <file>logs/error.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-8level %logger{32} - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="DEBUG_LOG" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <level>DEBUG</level>
        <onMatch>ACCEPT</onMatch>
        <onMismatch>DENY</onMismatch>
        <file>logs/debug.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-8level %logger{32} - %msg%n</pattern>
        </encoder>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/debug-%d{yyyy-MM-dd HH:mm:ss.SSS}.log</fileNamePattern>
            <maxHistory>7</maxHistory>
            <totalSizeCap>4GB</totalSizeCap>
            <maxFileSize>128MB</maxFileSize>
        </rollingPolicy>
    </appender>

    <appender name="ASYNC_DEBUG_LOG" class="ch.qos.logback.classic.AsyncAppender">
        <appender-ref ref="DEBUG_LOG"/>
        <neverBlock>true</neverBlock>
        <queueSize>128</queueSize>
    </appender>

    <root level="ERROR">
        <appender-ref ref="ASYNC_INFO_LOG"/>
        <appender-ref ref="ASYNC_DEBUG_LOG"/>
        <appender-ref ref="ERROR_LOG"/>
    </root>

</configuration>